  },
  "jump": { "base": 65536, "s3Shift": 12, "dashBonus": 65536, "_note": "[확인] vz=0x10000+(s3<<12), 대시중 +0x10000" },
  "catch": { "windowAdj": 2, "_note": "[확인 구조] 캐치 자세 s5 프레임. 성공 조건 남은타이머<=15-windowAdj(0x8CF0). 정면(공이 선수 쪽으로 진행)일 때만 성공" },
